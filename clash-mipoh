# 名称： OpenClash & Clash Mi 融合完美版配置文件
# 适用： 手机端 Clash Mi (Mihomo 内核) 
# 特性： 继承 PC 端 0.1x EMBY 专属分流、精简 AI 分组，包含手机专用 TUN/DNS 地基

# ※※※※※※※※※※※※※※※ 锚点区域 ※※※※※※※※※※※※※※※
# ① 订阅锚点
Anchor_PR: &Anchor_PR {type: http, interval: 86400, proxy: DIRECT, health-check: {enable: true, url: 'https://www.g.cn/generate_204', interval: 300}, filter: "^(?!.*(到期|过期|剩余|网址|官网|邮箱|订阅|套餐|流量|说明|重置)).*$"}
# ② 出站锚点 (融合你的自定义策略组作为可选出站)
Anchor_OB: &Anchor_OB {type: select, proxies: [所有-自动, 低倍率-自动, 港台日新韩-自动, 台日新韩-自动, 香港-自动, 台湾-自动, 日本-自动, 新加坡-自动, 韩国-自动, 美国-自动, 其他-自动, 所有-手动, DIRECT, REJECT]}
# ③ 策略锚点
Anchor_HS: &Anchor_HS {type: select, include-all: true}
Anchor_FB: &Anchor_FB {type: fallback, url: 'https://www.g.cn/generate_204', interval: 300, lazy: false, timeout: 2000, max-failed-times: 3, hidden: true}
Anchor_UT: &Anchor_UT {type: url-test, url: 'https://www.g.cn/generate_204', interval: 300, lazy: false, tolerance: 50, timeout: 2000, max-failed-times: 3, hidden: true, include-all: true}

# ④ 区域及低倍率过滤锚点 (结合原模板与你的正则)
Anchor_EMBY: &Anchor_EMBY '^(?i)(?=.*(EMBY|0\.1x|0\.5x)).*$'
Anchor_HK: &Anchor_HK '^(?i)(?=.*(广港|香港|🇭🇰|\bHK\b|Hong(?:\s?Kong)?|HKG)).*$'
Anchor_TW: &Anchor_TW '^(?i)(?=.*(广台|台湾|台灣|🇹🇼|\bTW\b|taiwan|TPE)).*$'
Anchor_JP: &Anchor_JP '^(?i)(?=.*(广日|日本|🇯🇵|\bJP\b|Japan|东京|大阪|川日)).*$'
Anchor_KR: &Anchor_KR '^(?i)(?=.*(广韩|韩国|韓國|🇰🇷|首尔|\bKR\b|Korea)).*$'
Anchor_SG: &Anchor_SG '^(?i)(?=.*(广新|新加坡|🇸🇬|\bSG\b|Singapore|坡|狮城)).*$'
Anchor_US: &Anchor_US '^(?i)(?=.*(广美|美国|美國|🇺🇸|\bUS\b|\bUSA\b|美)).*$'
Anchor_ASIA: &Anchor_ASIA '^(?i)(?=.*(广港|广台|广日|广新|广韩|广美|香港|HK|台湾|TW|日本|JP|新加坡|SG|韩国|KR|🇭🇰|🇹🇼|🇯🇵|🇸🇬|🇰🇷)).*$'
Anchor_NO_HK: &Anchor_NO_HK '^(?i)(?=.*(广台|广日|广新|广韩|广美|台湾|TW|日本|JP|新加坡|SG|韩国|KR|🇹🇼|🇯🇵|🇸🇬|🇰🇷)).*$'
Anchor_OT: &Anchor_OT '^(?!.*(DIRECT|直接连接|香港|台湾|台灣|日本|韩国|韓國|新加坡|美国|美國|🇭🇰|🇹🇼|🇸🇬|🇯🇵|🇰🇷|🇺🇸|HK|TW|SG|JP|KR|US|广港|广台|广日|广新|广韩|广美)).*$'

# ⑤ 规则来源数据锚点
Anchor_IP: &Anchor_IP {type: http, interval: 86400, behavior: ipcidr, format: mrs}
Anchor_DN: &Anchor_DN {type: http, interval: 86400, behavior: domain, format: mrs}

# ※※※※※※※※※※※※※※※ 核心配置 ※※※※※※※※※※※※※※※
mixed-port: 7893
mode: rule
allow-lan: true
bind-address: "*"
tcp-concurrent: true
unified-delay: true
log-level: info
ipv6: true
profile:
  store-selected: true
  store-fake-ip: true

external-ui-name: zashboard
external-ui: ui
external-controller: 0.0.0.0:9090
secret: ""

# 📱 手机专用网卡接管设置
tun:
  enable: true
  stack: system
  dns-hijack: [0.0.0.0:53]
  auto-detect-interface: true
  auto-route: true
  auto-redirect: true
  strict-route: false
  endpoint-independent-nat: true

sniffer:
  enable: true
  override-destination: true
  parse-pure-ip: true
  force-dns-mapping: true
  sniff:
    QUIC: {ports: [443]}
    TLS: {ports: [443, 8443]}
    HTTP: {ports: [80, 8080-8880], override-destination: true}
  force-domain:
    - "+.netflix.com"
    - "+.nflxvideo.net"
    - "+.amazonaws.com"
    - "+.media.dssott.com"
  skip-domain:
    - "+.apple.com"
    - Mijia Cloud
    - dlg.io.mi.com
    - "+.oray.com"
    - "+.sunlogin.net"
    - "+.push.apple.com"

# 📱 手机专用精细化 DNS 解析
dns:
  enable: true
  listen: 0.0.0.0:7874
  ipv6: true
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter-mode: blacklist
  respect-rules: false
  fake-ip-filter:
    - '*.lan'
    - "rule-set:cn_domain"
  default-nameserver:
    - 114.114.114.114
    - tls://223.5.5.5:853
  nameserver:
    - https://doh.pub/dns-query
    - https://dns.alidns.com/dns-query

# ※※※※※※※※※※※※※※※ 代理策略组 ※※※※※※※※※※※※※※※
