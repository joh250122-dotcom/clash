mode: rule
ipv6: false
mixed-port: 20112
allow-lan: true
log-level: info
interface-name: ""
port: 0
socks-port: 0
secret: 6e1755c3e6f3532c66ebfe8c3eabc2d5ef6f85d0766ccb503170fe9ef3050322
external-controller: 127.0.0.1:20113
external-ui: ""
keep-alive-interval: 30
find-process-mode: strict
external-controller-tls: ""
external-ui-name: ""
external-ui-url: ""
unified-delay: true
tcp-concurrent: false
authentication: []
skip-auth-prefixes:
  - 127.0.0.1/8
  - ::1/128
tls:
  certificate: ""
  private-key: ""
geodata-mode: false
geo-auto-update: false
geo-update-interval: 24
geodata-loader: standard
geosite-matcher: mph
geox-url:
  geoip: ""
  geosite: ""
  mmdb: ""
  asn: ""
global-ua: chrome
profile:
  store-selected: true
  store-fake-ip: true
lan-allowed-ips:
  - 0.0.0.0/0
  - ::/0
lan-disallowed-ips: []
tun:
  enable: true
  stack: gVisor
  auto-route: true
  auto-detect-interface: true
  dns-hijack:
    - any:53
  device: ""
  mtu: 0
  strict-route: true
  endpoint-independent-nat: true
dns:
  enable: true
  ipv6: false
  use-hosts: false
  use-system-hosts: true
  nameserver:
    - https://223.5.5.5/dns-query
    - https://8.8.8.8/dns-query
  nameserver-policy:
    rule-set:GEOSITE-CN: https://223.5.5.5/dns-query#🎯 全球直连
    rule-set:geolocation-!cn: tls://8.8.8.8#🚀 节点选择
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-range6: fc00::/18
  fake-ip-filter-mode: blacklist
  fake-ip-filter:
    - "*.lan"
    - "*.localdomain"
    - "*.example"
    - "*.invalid"
    - "*.localhost"
    - "*.test"
    - "*.local"
    - "*.home.arpa"
    - "*.msftconnecttest.com"
    - "*.msftncsi.com"
  prefer-h3: false
sniffer:
  enable: true
  force-dns-mapping: false
  parse-pure-ip: true
  override-destination: false
  force-domain: []
  skip-domain: []
  skip-src-address: []
  skip-dst-address: []
  sniff:
    HTTP:
      ports:
        - "80"
        - 8080-8880
    TLS:
      ports:
        - "443"
        - "8443"
    QUIC:
      ports:
        - "443"
        - "8443"
hosts: {}
proxy-providers: {}
rule-providers:
  geosite-telegram:
    type: http
    url: ""
    behavior: domain
    format: mrs
    proxy: 🚀 节点选择
    interval: 0
  Streaming-Proxy:
    type: http
    url: ""
    behavior: domain
    format: mrs
    proxy: 🚀 节点选择
    interval: 0
  geosite-openai:
    type: http
    url: ""
    behavior: domain
    format: mrs
    proxy: 🚀 节点选择
