  - name: GLOBAL
    type: select
    filter: ""
    exclude-filter: ""
    hidden: false
    icon: ""
    proxies:
      - 🚀 节点选择
      - 🎈 自动选择
      - 🎯 全球直连
      - 🛑 全球拦截
      - 🐟 漏网之鱼
