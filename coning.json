rules:
  - RULE-SET,geosite-telegram,Social-Proxy
  - RULE-SET,Streaming-Proxy,Streaming-Proxy
  - RULE-SET,geosite-openai,AI-Proxy
  - AND,((DST-PORT,443),(NETWORK,udp)),🛑 全球拦截
  - RULE-SET,category-ads-all,🛑 全球拦截
  - RULE-SET,GEOIP-Private,🎯 全球直连,no-resolve
  - RULE-SET,GEOIP-CN,🎯 全球直连,no-resolve
  - RULE-SET,GEOSITE-Private,🎯 全球直连
  - RULE-SET,GEOSITE-CN,🎯 全球直连
  - RULE-SET,geolocation-!cn,🚀 节点选择
  - MATCH,🐟 漏网之鱼
route:
  rules:
    - rule_set: geosite-openai
      outbound: AI-Proxy
    - rule_set:
        - geosite-netflix
        - geosite-youtube
      outbound: Streaming-Proxy
    - rule_set:
        - geosite-telegram
        - geosite-twitter
      outbound: Social-Proxy
  rule_set:
    - tag: geosite-openai
      type: remote
      format: binary
      url: https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-openai.srs
      download_detour: 节点选择
    - tag: geosite-netflix
      type: remote
      format: binary
      url: https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-netflix.srs
